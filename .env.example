# Server only. Use a Stripe test key during development.
STRIPE_SECRET_KEY=
# Trusted public origin used for Stripe redirects (no trailing slash).
APP_URL=http://localhost:5173
PORT=3001
# Activate only after configuring actual store information. Start with a test key.
CHECKOUT_ENABLED=false
# Signing secret for the /api/stripe/webhook endpoint. Server only.
STRIPE_WEBHOOK_SECRET=
